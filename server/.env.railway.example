# Railway environment variables template
# Set ALL of these in Railway Dashboard → Your Service → Variables
# Do NOT commit real values — this file is a reference only.

# --- Server ---
NODE_ENV=production
APP_URL=https://your-app.up.railway.app   # Replace with your actual Railway URL after first deploy

# --- Database (persistent volume) ---
DB_PATH=/app/data/builderslab.db          # Must match the Railway volume mount path

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_freshly_generated_secret
JWT_EXPIRES_IN=30d
COOKIE_SECURE=true

# --- AI credential encryption ---
AI_CREDENTIALS_KEY=replace_with_freshly_generated_secret

# --- Bootstrap admin (used once: npm run seed:admin via Railway shell) ---
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@dalijaytechhub.com
ADMIN_PASSWORD=change_this_before_first_login
ADMIN_PHONE=233XXXXXXXXX

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_live_your_key_here
REGISTRATION_FEE_GHS=350
MONTHLY_FEE_GHS=180

# --- File uploads ---
UPLOAD_DIR=/app/uploads                   # Must match the Railway volume mount path (or subfolder)
MAX_UPLOAD_MB=25

# --- Optional ---
GEMINI_API_KEY=
