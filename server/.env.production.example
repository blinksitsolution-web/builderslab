# Production template for builderslab.dalijaytechhub.com on InterServer cPanel.
# Copy to server/.env on the server (or paste these as cPanel Node.js env vars).
# Generate fresh secrets — never reuse development values.

# --- Server ---
# PORT is usually set automatically by cPanel/Passenger — leave unset unless support asks you to set it.
NODE_ENV=production
APP_URL=https://builderslab.dalijaytechhub.com

# --- Auth ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_freshly_generated_random_secret
JWT_EXPIRES_IN=30d
COOKIE_SECURE=true

# --- AI provider credential encryption ---
AI_CREDENTIALS_KEY=replace_with_a_freshly_generated_random_secret

# --- Bootstrap admin (used once: npm run seed:admin) ---
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@dalijaytechhub.com
ADMIN_PASSWORD=change_this_immediately_before_first_login
ADMIN_PHONE=0000000000

# --- Paystack ---
# Use sk_test_ while testing, sk_live_ when ready for real payments.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
REGISTRATION_FEE_GHS=350
MONTHLY_FEE_GHS=180

# --- AI quiz generation (optional) ---
GEMINI_API_KEY=

# --- File uploads (defaults are fine for cPanel) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- SQLite database (default path; only change if support relocates data) ---
# DB_PATH=./data/builderslab.db
