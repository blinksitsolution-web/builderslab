# --- Server ---
PORT=4000
NODE_ENV=development
# Public URL of this deployment, used in links/CORS. No trailing slash.
# The value below is correct for local testing. Change it to your real
# domain (e.g. https://www.example.com) when you deploy.
APP_URL=http://localhost:4000

# --- Auth ---
# Generate your own random secret — do NOT reuse this placeholder, and do
# NOT reuse the same secret across environments (local/staging/production
# should each have their own). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_freshly_generated_random_secret
JWT_EXPIRES_IN=30d
# Cookies only work over HTTPS when this is true. Set to false for local
# testing (localhost is plain http://) — switch back to true in production.
COOKIE_SECURE=false

# --- AI provider credential encryption (decoupled from JWT_SECRET) ---
# Encrypts Groq/Anthropic keys stored in the database. Kept separate from
# JWT_SECRET so rotating JWT_SECRET never breaks stored AI provider keys.
# Generate your own with the same command as JWT_SECRET above. If you
# already have AI provider keys saved and are adding this for the first
# time, run `npm run rotate:ai-key` afterwards to migrate them onto it —
# see SECRET_ROTATION.md.
AI_CREDENTIALS_KEY=replace_with_a_freshly_generated_random_secret

# --- Bootstrap admin (used once by `npm run seed:admin`) ---
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_immediately
ADMIN_PHONE=0000000000

# --- Paystack (supports MTN MoMo, Vodafone Cash, AirtelTigo Money in Ghana) ---
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use the sk_test_ key while integrating, sk_live_ key only once verified end-to-end.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
REGISTRATION_FEE_GHS=350
MONTHLY_FEE_GHS=180

# --- AI quiz generation (optional) ---
# If unset, the server falls back to the curated question bank in
# src/data/lessons.js so the platform still works without this key.
GEMINI_API_KEY=

# --- File uploads ---
# Local disk is fine for a first production launch. For real scale, point
# this at S3/Cloudinary instead and update src/routes/projects.js.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Backups (optional — see BACKUPS.md) ---
# All have working defaults (server/data/backups, server/data/backups/uploads,
# 14 backups kept) and only need setting if you want a different location —
# e.g. a separate mounted volume as the first copy off the primary disk,
# ahead of syncing it off-site (BACKUPS.md's "Off-site copy" section).
# BACKUP_DIR=./data/backups
# UPLOADS_BACKUP_DIR=./data/backups/uploads
# BACKUP_RETENTION_COUNT=14
